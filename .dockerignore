# Deny by default: local credentials and history never reach the build context.
**
!Dockerfile
!.dockerignore
!backend/
!backend/**
!vendor/
!vendor/doubao_voice/
!vendor/doubao_voice/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/tailwind.config.js
!frontend/postcss.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!API.md
!docs/
!docs/llms.txt
!examples/
!examples/**
**/__pycache__/**
**/*.pyc
**/node_modules/**
**/.env*
**/auth*.json
**/llm.json
**/settings.local.json
**/*cookies*
**/*credentials*
**/*.pem
**/*.key
**/*.log
