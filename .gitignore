# Publish only the application, its documentation, and reproducible build inputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/API.md
!/auth.example.json
!/settings.example.json
!/requirements-dev.txt
!/install.bat
!/build.bat
!/start.bat
!/dev-backend.bat
!/dev-frontend.bat
!/启动豆包语音工作室.command
!/停止豆包语音工作室.command
!/transcribe.py
!/backend/
!/frontend/
!/docs/
!/examples/
!/tests/
!/vendor/
!/.github/

# Credentials and machine-specific settings must never be committed.
**/auth.json
**/auth.*.json
!/auth.example.json
**/llm.json
**/settings.local.json
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*cookies*
**/*credentials*

# Runtime outputs, dependencies, caches and local research material.
**/__pycache__/
**/*.py[cod]
**/*.log
**/node_modules/
**/.venv/
**/venv/
**/.pytest_cache/
**/*.tsbuildinfo
/frontend/dist/
/logs/
/transcribe_out/
/chat_out/
/verification/
/backups/
/doubao_voice_asr_tts/
